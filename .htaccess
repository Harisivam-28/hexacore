<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Native Hostinger API Endpoints (Contact form, Quote request, Health check)
    RewriteRule ^api/contacts/?$ api/contacts.php [L,QSA]
    RewriteRule ^api/quotes/?$ api/quotes.php [L,QSA]
    RewriteRule ^api/health/?$ api/health.php [L,QSA]

    # Redirect /index.html and /frontend.html to /
    RewriteCond %{THE_REQUEST} \s/+(index|frontend)\.html[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # Redirect old *.html requests to clean URLs (301 Permanent Redirect)
    RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # Special clean aliases
    RewriteRule ^newsletter/?$ /about#newsletter-section [R=301,NE,L]
    RewriteRule ^quote/?$ /contact [R=301,L]
    RewriteRule ^product/?$ /products [R=301,L]

    # Serve existing files & directories (images, css, js, admin) directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Internal rewrite clean URLs to corresponding .html file
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>
